{
  "expo": {
    "name": "Outside",
    "slug": "outside-nature-break",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/outside-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.outside.naturebreak",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F1F3",
        "foregroundImage": "./assets/outside-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.outside.naturebreak"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Outside uses your microphone only when you choose to speak a check-in.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store"
    ],
    "platforms": [
      "ios",
      "android"
    ]
  }
}
