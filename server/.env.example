# Copy to .env. Never commit your keys.
PORT=3001
# Generate a private prototype access code: openssl rand -hex 24
OUTSIDE_ACCESS_TOKEN=
ELEVENLABS_API_KEY=
# River, a calm premade voice. Verify API access with your own account.
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
# An OpenAI-compatible endpoint serving Gemma, e.g. local Ollama:
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=ollama
# Optional custom paths for locally installed FFmpeg tools.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
